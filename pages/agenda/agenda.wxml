<view class="page">

  <view class="card stat-card">
    <view class="stat-text">{{statText}}</view>
  </view>

  <view wx:if="{{total}}" class="card">
    <view wx:for="{{groups}}" wx:key="key" class="group">
      <view class="g-head">
        <view class="g-date">
          <text class="gd-main">{{item.dateText}}</text>
          <text class="gd-lunar">农历{{item.lunarDay}}</text>
          <text class="gd-week">{{item.weekCn}}</text>
          <text class="gd-rel {{item.passed ? 'passed' : ''}}">{{item.relText}}</text>
        </view>
        <view class="g-fest" wx:if="{{item.fest}}">{{item.fest}}</view>
      </view>
      <view wx:for="{{item.items}}" wx:for-item="n" wx:key="id" class="note-item">
        <text class="ni-text">{{n.text}}</text>
        <text class="ni-del" data-key="{{item.key}}" data-id="{{n.id}}" bindtap="delNote">删除</text>
      </view>
    </view>
  </view>

  <view wx:else class="card">
    <view class="empty">还没有任何备忘</view>
    <view class="empty-sub">回到日历，点任意一天就能添加</view>
  </view>

  <view class="btn-back" bindtap="goIndex">回到日历</view>
</view>
